<?xml version="1.0" encoding="UTF-8"?>
<cache xmlns="http://maven.apache.org/BUILD-CACHE-CONFIG/1.2.0"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://maven.apache.org/BUILD-CACHE-CONFIG/1.2.0 https://maven.apache.org/xsd/build-cache-config-1.2.0.xsd">
    <!--
      The local build cache (~/.m2/build-cache): a module whose sources, POM and dependencies did not change is not
      built again, tests and static analysis included; its outputs are restored into target/.
    -->
    <configuration>
        <enabled>true</enabled>
        <hashAlgorithm>XX</hashAlgorithm>
        <local>
            <maxBuildsCached>3</maxBuildsCached>
        </local>
        <!-- what reads target/ rather than the jars: the IDE, spring-boot:run, exec:java in ci/start-demo.sh -->
        <attachedOutputs>
            <dirNames>
                <dirName>classes</dirName>
                <dirName>test-classes</dirName>
            </dirNames>
        </attachedOutputs>
    </configuration>
    <!-- the checkstyle rules, at the root: the modules are one level below it -->
    <input>
        <global>
            <includes>
                <include recursive="false" glob="checkstyle.xml">..</include>
            </includes>
        </global>
    </input>
    <!--
      A cached build stands in for another one only when these parameters are the same: a run of selected tests
      (-Dtest=…, -Dit.test=…) runs them, and a build without tests (-DskipTests, -DskipITs) never replaces one with
      tests.
    -->
    <executionControl>
        <reconcile>
            <plugins>
                <plugin artifactId="maven-surefire-plugin" goal="test">
                    <reconciles>
                        <reconcile propertyName="test"/>
                        <reconcile propertyName="skip" skipValue="true"/>
                        <reconcile propertyName="skipExec" skipValue="true"/>
                        <reconcile propertyName="skipTests" skipValue="true"/>
                    </reconciles>
                </plugin>
                <plugin artifactId="maven-failsafe-plugin" goal="integration-test">
                    <reconciles>
                        <reconcile propertyName="test"/>
                        <reconcile propertyName="skip" skipValue="true"/>
                        <reconcile propertyName="skipITs" skipValue="true"/>
                        <reconcile propertyName="skipTests" skipValue="true"/>
                    </reconciles>
                </plugin>
            </plugins>
        </reconcile>
    </executionControl>
</cache>
