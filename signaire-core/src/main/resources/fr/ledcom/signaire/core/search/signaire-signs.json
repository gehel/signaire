{
  "settings": {
    "analysis": {
      "filter": {
        "elision_fr_it": {
          "type": "elision",
          "articles_case": true,
          "articles": ["l", "m", "t", "qu", "n", "s", "j", "d", "c", "jusqu", "quoiqu", "lorsqu", "puisqu",
                       "dell", "nell", "all", "sull", "dall", "un", "quest", "quell"]
        },
        "prefix_ngram": {"type": "edge_ngram", "min_gram": 1, "max_gram": 20},
        "light_french": {"type": "stemmer", "language": "light_french"},
        "light_german": {"type": "stemmer", "language": "light_german"},
        "light_italian": {"type": "stemmer", "language": "light_italian"}
      },
      "normalizer": {
        "folding": {"type": "custom", "filter": ["lowercase", "asciifolding"]}
      },
      "analyzer": {
        "folding": {"tokenizer": "standard", "filter": ["elision_fr_it", "lowercase", "asciifolding"]},
        "folding_prefix": {
          "tokenizer": "standard",
          "filter": ["elision_fr_it", "lowercase", "asciifolding", "prefix_ngram"]
        },
        "french": {"tokenizer": "standard", "filter": ["elision_fr_it", "lowercase", "light_french", "asciifolding"]},
        "german": {"tokenizer": "standard", "filter": ["lowercase", "german_normalization", "light_german", "asciifolding"]},
        "italian": {"tokenizer": "standard", "filter": ["elision_fr_it", "lowercase", "light_italian", "asciifolding"]}
      }
    }
  },
  "mappings": {
    "dynamic": false,
    "properties": {
      "uid": {"type": "keyword"},
      "language": {"type": "keyword"},
      "status": {"type": "keyword"},
      "categories": {"type": "keyword"},
      "dialects": {"type": "keyword"},
      "name": {
        "type": "text",
        "analyzer": "folding",
        "fields": {
          "sort": {"type": "keyword", "normalizer": "folding"},
          "prefix": {"type": "text", "analyzer": "folding_prefix", "search_analyzer": "folding"}
        }
      },
      "periphrase": {
        "type": "text",
        "analyzer": "folding",
        "fields": {
          "fr": {"type": "text", "analyzer": "french"},
          "de": {"type": "text", "analyzer": "german"},
          "it": {"type": "text", "analyzer": "italian"}
        }
      },
      "definition": {
        "type": "text",
        "analyzer": "folding",
        "fields": {
          "fr": {"type": "text", "analyzer": "french"},
          "de": {"type": "text", "analyzer": "german"},
          "it": {"type": "text", "analyzer": "italian"}
        }
      },
      "examples": {
        "properties": {
          "text": {
            "type": "text",
            "analyzer": "folding",
            "fields": {
              "fr": {"type": "text", "analyzer": "french"},
              "de": {"type": "text", "analyzer": "german"},
              "it": {"type": "text", "analyzer": "italian"}
            }
          }
        }
      }
    }
  }
}
