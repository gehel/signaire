<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.wikimedia</groupId>
        <artifactId>wmf-jvm-parent-pom</artifactId>
        <version>1.102</version>
    </parent>

    <groupId>fr.ledcom</groupId>
    <artifactId>signaire</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Signaire</name>
    <description>Swiss sign language lexicon: search, personal word lists and learning material, based on SignSuisse data.</description>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>The code only: the SignSuisse data belongs to the SGB-FSS and is never distributed.</comments>
        </license>
    </licenses>

    <modules>
        <module>signaire-model</module>
        <module>signaire-bundle</module>
        <module>signaire-extractor</module>
        <module>signaire-core</module>
        <module>signaire-accounts</module>
        <module>signaire-export</module>
        <module>signaire-cli</module>
        <module>signaire-web</module>
        <module>signaire-it</module>
    </modules>

    <properties>
        <archunit.version>1.5.1</archunit.version>
        <!--
          Tests run in French, the base language, whatever the locale of the machine. They never reach the
          network, SignSuisse least of all: HTTP goes to a closed local port, except for localhost (containers).
          Test JVMs are short lived: the quick compiler and the serial collector start them faster. Lucene and SQLite
          call native code, which the JDK will refuse unless allowed (the jars allow it in their manifest). The modules
          that use Mockito load its agent at startup: the JDK will refuse agents loaded while running.
        -->
        <argLine>-XX:TieredStopAtLevel=1 -XX:+UseSerialGC -Duser.language=fr -Duser.country=CH -Dhttp.proxyHost=127.0.0.1 -Dhttp.proxyPort=9 -Dhttps.proxyHost=127.0.0.1 -Dhttps.proxyPort=9 -Dhttp.nonProxyHosts=localhost|127.0.0.1|[::1] --enable-native-access=ALL-UNNAMED</argLine>
        <commonmark.version>0.33.0</commonmark.version>
        <!-- the version from the parent POM cannot parse Java 27 class files -->
        <forbiddenapis.version>3.11</forbiddenapis.version>
        <htmx.version>4.0.2</htmx.version>
        <jsoup.version>1.24.1</jsoup.version>
        <lucene.version>10.6.0</lucene.version>
        <maven.compiler.release>27</maven.compiler.release>
        <maven.compiler.source>27</maven.compiler.source>
        <maven.compiler.target>27</maven.compiler.target>
        <pdfbox.version>3.0.8</pdfbox.version>
        <pico.version>2.1.1</pico.version>
        <picocli.version>4.7.7</picocli.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- the version from the parent POM cannot read Java 27 class files -->
        <spotbugs.version>4.10.5</spotbugs.version>
        <spring-boot.version>4.2.0</spring-boot.version>
        <zxing.version>3.5.4</zxing.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-annotations</artifactId>
                <version>${spotbugs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.zxing</groupId>
                <artifactId>core</artifactId>
                <version>${zxing.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.ledcom</groupId>
                <artifactId>signaire-accounts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.ledcom</groupId>
                <artifactId>signaire-bundle</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.ledcom</groupId>
                <artifactId>signaire-cli</artifactId>
                <version>${project.version}</version>
                <classifier>jar-with-dependencies</classifier>
            </dependency>
            <dependency>
                <groupId>fr.ledcom</groupId>
                <artifactId>signaire-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.ledcom</groupId>
                <artifactId>signaire-core</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>fr.ledcom</groupId>
                <artifactId>signaire-export</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.ledcom</groupId>
                <artifactId>signaire-extractor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.ledcom</groupId>
                <artifactId>signaire-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.ledcom</groupId>
                <artifactId>signaire-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli-spring-boot-starter</artifactId>
                <version>${picocli.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-analysis-common</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-core</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
            <dependency>
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark</artifactId>
                <version>${commonmark.version}</version>
            </dependency>
            <dependency>
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark-ext-gfm-tables</artifactId>
                <version>${commonmark.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jsoup</groupId>
                <artifactId>jsoup</artifactId>
                <version>${jsoup.version}</version>
            </dependency>
            <dependency>
                <groupId>org.webjars.npm</groupId>
                <artifactId>htmx.org</artifactId>
                <version>${htmx.version}</version>
            </dependency>
            <dependency>
                <groupId>org.webjars.npm</groupId>
                <artifactId>picocss__pico</artifactId>
                <version>${pico.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <!-- the version from the parent POM cannot read Java 27 class files -->
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>4.10.5.0</version>
                </plugin>
                <plugin>
                    <groupId>de.thetaphi</groupId>
                    <artifactId>forbiddenapis</artifactId>
                    <configuration>
                        <suppressAnnotations>
                            <!-- any annotation of that name, with a reason, can justify a forbidden API use -->
                            <suppressAnnotation>**.SuppressForbidden</suppressAnnotation>
                        </suppressAnnotations>
                    </configuration>
                </plugin>
                <plugin>
                    <!-- the checkstyle of the parent POM (10.16) rejects unnamed variables (_); 13.9 and later lack
                         the JavadocStyle check of the WMF ruleset, so the rules are our copy (checkstyle.xml) -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>3.6.0</version>
                    <dependencies>
                        <dependency>
                            <groupId>com.puppycrawl.tools</groupId>
                            <artifactId>checkstyle</artifactId>
                            <version>14.4.0</version>
                        </dependency>
                    </dependencies>
                    <executions>
                        <execution>
                            <id>validate</id>
                            <configuration>
                                <configLocation>${maven.multiModuleProjectDirectory}/checkstyle.xml</configLocation>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <!-- the parent runs Lombok, which we don't use (and which calls sun.misc.Unsafe in javac) -->
                        <annotationProcessorPaths combine.self="override"/>
                        <proc>none</proc>
                    </configuration>
                </plugin>
                <plugin>
                    <!-- the paths of the dependencies as properties (${groupId:artifactId:jar}), for agents -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>dependency-paths</id>
                            <goals>
                                <goal>properties</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <executions>
                        <execution>
                            <!-- deprecated by its authors, and JDepend reads no class file newer than Java 8:
                                 PackageCyclesTest (ArchUnit) in each module -->
                            <id>enforce-no-package-cycles</id>
                            <phase>none</phase>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <!-- Spring Boot repackages the jar: run the tests on the classes instead -->
                        <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.basepom.maven</groupId>
                    <artifactId>duplicate-finder-maven-plugin</artifactId>
                    <configuration>
                        <ignoredResourcePatterns>
                            <!-- public suffix list, shipped by both httpclient5 and docker-java (Testcontainers) -->
                            <ignoredResourcePattern>org/publicsuffix/list/effective_tld_names\.dat</ignoredResourcePattern>
                        </ignoredResourcePatterns>
                    </configuration>
                </plugin>
                <plugin>
                    <!-- the version from the parent POM cannot read Java 27 class files -->
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.16</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
